# Kanonski URL sajta (SEO, JSON-LD, sitemap).
# MORA da bude host koji vraca 200, ne onaj koji redirectuje.
# santos.rs vraca 308 -> www.santos.rs, pa ovde ide www varijanta:
#   NEXT_PUBLIC_SITE_URL=https://www.santos.rs
# Ako je postavljen apex, svaki canonical i svaki URL u sitemap-u pokazuje na redirect.
NEXT_PUBLIC_SITE_URL=https://www.santos.rs
# Opciono: dodatni profili za Organization sameAs (JSON-LD), odvojeni zarezom ili novim redom
# NEXT_PUBLIC_ORG_SAME_AS=https://www.instagram.com/...,https://www.facebook.com/...
NEXT_PUBLIC_BACKEND_BASE=/api/
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TRANSPARENT_CDN_BASE=
NEXT_PUBLIC_TRANSPARENT_LOCAL_BASE=
NEXT_PUBLIC_PHOTO_CDN_BASE=
NEXT_PUBLIC_PREVIEW_EXPOSURE_PHOTO=
NEXT_PUBLIC_FORCE_PHOTO_VARIANT=
NEXT_PUBLIC_VEST_FEATURE=1
NEXT_PUBLIC_PARITY_MODE=
NEXT_PUBLIC_PARITY_DEBUG=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kupacki login/registracija (Supabase Auth): u konzoli ukljuci Email i Google providere, Site URL = domen sajta.
# Redirect URLs (obavezno): https://<domen>/auth/callback, http://localhost:3000/auth/callback,
# i https://<domen>/nalog/prijava, http://localhost:3000/nalog/prijava
# Za Google: u Google Cloud OAuth Client dodaj Authorized redirect URI:
# https://<supabase-project-ref>.supabase.co/auth/v1/callback
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCTS_BUCKET=products
BUTTON_REFERENCE_ID=
ADMIN_ACCESS_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# OBAVEZNO u produkciji. Koristi se za HMAC sesijskog tokena.
# Ako nije postavljen, pada na nesiguran default uz warning u serverskim logovima.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_SESSION_SECRET=
# Google OAuth za admin prijavu (Google Cloud: OAuth 2.0 Client, tip Web)
# Redirect URI mora biti: https://<domen>/api/admin/auth/google/callback (i http://localhost:3000/... za dev)
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
# Opciono: fiksni redirect (mora 100% da odgovara URI-ju u Google Cloud). Koristi samo ako
# startujes OAuth sa istog hosta; inace state cookie ne stize u callback.
# ADMIN_GOOGLE_REDIRECT_URI=https://your-domain.com/api/admin/auth/google/callback
# Dodatni admin Google mejlovi (zarezom). Ugradjeni owner nalozi su uvek ukljuceni u kodu.
ADMIN_GOOGLE_ALLOWED_EMAILS=
ANANAS_API_BASE_URL=https://api.ananas.rs
ANANAS_CLIENT_ID=
ANANAS_CLIENT_SECRET=
ANANAS_STAGE_API_BASE_URL=https://api.qa2.ananastest.com
ANANAS_STAGE_CLIENT_ID=
ANANAS_STAGE_CLIENT_SECRET=
ANANAS_PROD_API_BASE_URL=https://api.ananas.rs
ANANAS_PROD_CLIENT_ID=
ANANAS_PROD_CLIENT_SECRET=
# Okruzenje koje koriste cron pozivi dok traje testiranje: stage | production
ANANAS_CRON_ENVIRONMENT=stage
# Posalji interni 9-cifreni mOffice kod u polju "ean". Ananas je potvrdio
# (29.07.2026) da prihvataju svoj kod umesto EAN-a; uslov je jedinstven SKU
# po varijanti. Podrazumevano ukljuceno; postavi na false samo da vratis
# strogu GTIN validaciju.
ANANAS_ALLOW_INTERNAL_EAN=true
# Automatski publish/unpublish ulistanih proizvoda (podrazumevano iskljuceno).
ANANAS_AUTO_PUBLISH=false
# Trajanje SALE akcije u danima (min 1, max 30; posle isteka ide obavezna pauza 1 dan).
ANANAS_SALE_WINDOW_DAYS=7
# --- Deljeni katalog snapshot (stednja Supabase egress-a) ---
# Bez ovoga svaka serverless instanca povlaci ceo katalog iz Supabase-a na svoj
# prvi zahtev. Kad je token postavljen, instance citaju snapshot sa
# /api/internal/catalog-snapshot, koji Vercel CDN kesira, pa baza vidi otprilike
# jedno citanje po kes prozoru umesto po instanci.
# Prazno = iskljuceno (cita se direktno iz Supabase-a, kao i do sada).
# Generisi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Svezina ne zavisi od ovog kesa: instance na 15s proveravaju najnoviji
# catalog_products.updated_at i same odbacuju kes kad se promeni.
CATALOG_SNAPSHOT_TOKEN=
# Opciono: host koji instanca zove. Podrazumevano NEXT_PUBLIC_SITE_URL, pa VERCEL_URL.
CATALOG_SNAPSHOT_BASE_URL=

STOCK_SYNC_SOURCE_ZIP_URL=
STOCK_SYNC_SOURCE_MD5_URL=
STOCK_OUTBOUND_SOURCE_MODE=legacy_tables
STOCK_OUTBOUND_LOOKBACK_DAYS=1
STOCK_OUTBOUND_ALLOW_ORDERS_FALLBACK=0
CRON_SECRET=

# --- cPanel FTP upload (site-assets) ---
# Ako su postavljeni, svi admin uploadi idu na cPanel hosting umesto Supabase Storage.
# Fajlovi se cuvaju u public_html/fajlovi/site-assets/ i serviraju kao /fajlovi/site-assets/...
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_REMOTE_BASE=/home/CPANEL_USER/public_html/fajlovi/site-assets

# --- Email notifikacije (Resend) ---
# Napravi nalog na https://resend.com, potvrdi domen santos.rs i dodaj DNS zapise:
# SPF, DKIM i DMARC moraju biti validni da poruke ne bi zavrsavale u spam-u.
# Ako je RESEND_API_KEY prazan, svi pozivi za slanje maila se tiho preskacu (dev-safe).
RESEND_API_KEY=
# Adresa posiljaoca (mora da bude na verifikovanom domenu). Ako je prazno, fallback je Santos & Santorini <no-reply@santos.rs>.
MAIL_FROM=
# Adresa na koju kupac moze da odgovori. Ako je prazno, fallback je info@santos.rs.
MAIL_REPLY_TO=
# Primalac notifikacija o porudzbinama (vise adresa moze razdvojeno zarezom).
ORDER_NOTIFICATION_EMAIL=
# Opciono: poseban primalac za kontakt poruke. Ako je prazno, koristi se ORDER_NOTIFICATION_EMAIL.
CONTACT_NOTIFICATION_EMAIL=
# Opciono: kod koji se automatski salje u welcome mailu pretplatnicima na newsletter (npr. WELCOME10).
NEWSLETTER_WELCOME_CODE=

# --- Analitika i marketing tagovi ---
# Bez ovih vrednosti sajt ne ucitava nijedan third-party skript.
# Server-only Vercel token za live podatke na /admin/analytics.
# Napravi token ogranicen na custom-suits projekat i dodaj ga kao
# Sensitive environment varijablu na Vercelu. Nikada ne koristi NEXT_PUBLIC_ prefiks.
VERCEL_ANALYTICS_TOKEN=
# Opciono: override ako se aplikacija premesti u drugi Vercel projekat/tim.
# Na Vercelu se VERCEL_PROJECT_ID i VERCEL_ORG_ID obicno dobijaju kao system env vars.
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
# Direktan link ka punom Vercel Web Analytics dashboardu.
VERCEL_ANALYTICS_DASHBOARD_URL=https://vercel.com/djordjes-projects-7892938d/custom-suits/analytics
# GA4 Measurement ID (Google Analytics > Admin > Data streams), npr. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID iz Events Managera.
NEXT_PUBLIC_META_PIXEL_ID=
# Valuta koja se salje uz ecommerce evente.
NEXT_PUBLIC_ANALYTICS_CURRENCY=RSD
# Meta Conversions API token (Events Manager > Settings > Generate access token).
# Kad je postavljen, purchase se salje i sa servera radi atribucije kad je pixel blokiran.
META_CAPI_ACCESS_TOKEN=
# Opciono: test_event_code dok se CAPI verifikuje u Events Manageru.
META_CAPI_TEST_EVENT_CODE=

# --- Admin sesija ---
# Koliko dana vazi potpisana admin sesija pre nego sto istekne. Default 30.
ADMIN_SESSION_MAX_AGE_DAYS=30
