# Kanonski URL sajta (SEO, JSON-LD, sitemap). Primer: https://custom-suits.vercel.app ili https://santos.rs
NEXT_PUBLIC_SITE_URL=
# Opciono: dodatni profili za Organization sameAs (JSON-LD), odvojeni zarezom ili novim redom
# NEXT_PUBLIC_ORG_SAME_AS=https://www.instagram.com/...,https://www.facebook.com/...
NEXT_PUBLIC_BACKEND_BASE=/api/
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TRANSPARENT_CDN_BASE=
NEXT_PUBLIC_TRANSPARENT_LOCAL_BASE=
NEXT_PUBLIC_PHOTO_CDN_BASE=
NEXT_PUBLIC_PREVIEW_EXPOSURE_PHOTO=
NEXT_PUBLIC_FORCE_PHOTO_VARIANT=
NEXT_PUBLIC_VEST_FEATURE=1
NEXT_PUBLIC_PARITY_MODE=
NEXT_PUBLIC_PARITY_DEBUG=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kupacki login/registracija (Supabase Auth): u konzoli ukljuci Email i Google providere, Site URL = domen sajta.
# Redirect URLs (obavezno): https://<domen>/auth/callback, http://localhost:3000/auth/callback,
# i https://<domen>/nalog/prijava, http://localhost:3000/nalog/prijava
# Za Google: u Google Cloud OAuth Client dodaj Authorized redirect URI:
# https://<supabase-project-ref>.supabase.co/auth/v1/callback
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCTS_BUCKET=products
BUTTON_REFERENCE_ID=
ADMIN_ACCESS_TOKEN=
ADMIN_USERNAME=santos
ADMIN_PASSWORD=santorini
# OBAVEZNO u produkciji. Koristi se za HMAC sesijskog tokena.
# Ako nije postavljen, pada na nesiguran default uz warning u serverskim logovima.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_SESSION_SECRET=
# Google OAuth za admin prijavu (Google Cloud: OAuth 2.0 Client, tip Web)
# Redirect URI mora biti: https://<domen>/api/admin/auth/google/callback (i http://localhost:3000/... za dev)
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
# Opciono: fiksni redirect (mora 100% da odgovara URI-ju u Google Cloud). Koristi samo ako
# startujes OAuth sa istog hosta; inace state cookie ne stize u callback.
# ADMIN_GOOGLE_REDIRECT_URI=https://your-domain.com/api/admin/auth/google/callback
# Dodatni admin Google mejlovi (zarezom). Ugradjeni owner nalozi su uvek ukljuceni u kodu.
ADMIN_GOOGLE_ALLOWED_EMAILS=
ANANAS_API_BASE_URL=https://api.ananas.rs
ANANAS_CLIENT_ID=
ANANAS_CLIENT_SECRET=
ANANAS_STAGE_API_BASE_URL=https://api.stage.ananastest.com
ANANAS_STAGE_CLIENT_ID=
ANANAS_STAGE_CLIENT_SECRET=
ANANAS_PROD_API_BASE_URL=https://api.ananas.rs
ANANAS_PROD_CLIENT_ID=
ANANAS_PROD_CLIENT_SECRET=
STOCK_SYNC_SOURCE_ZIP_URL=
STOCK_SYNC_SOURCE_MD5_URL=
STOCK_OUTBOUND_SOURCE_MODE=legacy_tables
STOCK_OUTBOUND_LOOKBACK_DAYS=1
STOCK_OUTBOUND_ALLOW_ORDERS_FALLBACK=0
CRON_SECRET=

# --- cPanel FTP upload (site-assets) ---
# Ako su postavljeni, svi admin uploadi idu na cPanel hosting umesto Supabase Storage.
# Fajlovi se cuvaju u public_html/fajlovi/site-assets/ i serviraju kao /fajlovi/site-assets/...
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_REMOTE_BASE=/home/agyc3416/public_html/fajlovi/site-assets

# --- Email notifikacije (Resend) ---
# Napravi nalog na https://resend.com, potvrdi domen santos.rs (SPF/DKIM), generisi API kljuc.
# Ako je RESEND_API_KEY prazan, svi pozivi za slanje maila se tiho preskacu (dev-safe).
RESEND_API_KEY=
# Adresa posiljaoca (mora da bude na verifikovanom domenu). Ako je prazno, fallback je Santos & Santorini <no-reply@santos.rs>.
MAIL_FROM=
# Primalac notifikacija o porudzbinama (vise adresa moze razdvojeno zarezom).
ORDER_NOTIFICATION_EMAIL=
# Opciono: poseban primalac za kontakt poruke. Ako je prazno, koristi se ORDER_NOTIFICATION_EMAIL.
CONTACT_NOTIFICATION_EMAIL=
# Opciono: kod koji se automatski salje u welcome mailu pretplatnicima na newsletter (npr. WELCOME10).
NEWSLETTER_WELCOME_CODE=
